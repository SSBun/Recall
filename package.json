{
  "name": "recall-rag",
  "private": true,
  "type": "module",
  "scripts": {
    "build:bridge": "esbuild runtime/model-bridge.ts --bundle --platform=node --format=esm --target=node22.19 --banner:js='import { createRequire } from \"node:module\";const require = createRequire(import.meta.url);' --outfile=src/recall/model_bridge.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./agent/extensions/rag-search.ts"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/proper-lockfile": "4.1.4",
    "esbuild": "0.25.12",
    "typebox": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "proper-lockfile": "4.1.2"
  }
}
